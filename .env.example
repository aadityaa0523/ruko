# Get your key at https://app.gnani.ai/voice and put it in a file named .env (never commit it)
GNANI_API_KEY=
# Phone-line mode (optional): Twilio auth token to verify webhooks, and the public https URL Twilio reaches
TWILIO_AUTH_TOKEN=
RUKO_PUBLIC_URL=
# Comma-separated API keys for partners calling POST /v1/score (the key "demo" always works, max 20 lines)
RUKO_PARTNER_KEYS=
# Web Push keys for Family Shield alerts (generate once; see README). Without them push alerts stay off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
